GOOGLE_CLOUD_PROJECT=your-project-id
VERTEX_AI_LOCATION=global

# Google API Key for LangChain integration (alternative to Vertex AI)
GOOGLE_API_KEY=your-google-api-key

# Elasticsearch Configuration
ELASTICSEARCH_URL=https://your-elasticsearch-cluster.es.region.provider.com:9243
ELASTICSEARCH_API_KEY=your_elasticsearch_api_key_here
ELASTICSEARCH_INDEX=rag-documents

# Optional: Path to CA certificates for Elasticsearch (if using self-signed certificates)
# ELASTICSEARCH_CA_CERTS=/path/to/ca-certificates.pem

# Optional: Custom paths
CHROMA_DB_PATH=./chroma_db
UPLOAD_DIR=./uploads
